# 复制为 .env 后填写；.env 不进 Git
# 访问口令，用户名固定 demo；Docker/NODE_ENV=production 必须设置，建议通过 HTTPS 代理
DEMO_PASSWORD=

# 模型：openai-completions / openai-responses / anthropic-messages / faux（本地无 Key 演示）
LLM_API=openai-completions
# OpenAI 兼容接口地址，例如 https://api.example.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_CONTEXT_WINDOW=128000
LLM_MAX_TOKENS=8192

# compose 用
HOST_PORT=3300

# v3 通知。URL 留空表示不向外推送；失败日志不会输出包含签名的地址
NOTIFY_WEBHOOK_URL=
# generic / feishu
NOTIFY_WEBHOOK_KIND=generic
# errors: 仅后台任务失败；all: 正常提醒、计划触发和后台完成也推送；off: 关闭
NOTIFY_MODE=errors
# 生产环境默认禁止模拟崩溃，仅录制崩溃恢复演示时临时改为 1
ENABLE_CRASH_DEMO=0
