# 复制为 .env 后填写；.env 不进 Git
# 访问口令，用户名固定 demo；公网访问时务必设置
DEMO_PASSWORD=

# 模型：openai-completions / openai-responses / anthropic-messages / faux（本地无 Key 演示）
LLM_API=openai-completions
LLM_BASE_URL=http://sub2api:8080/v1
LLM_API_KEY=
LLM_MODEL=
LLM_CONTEXT_WINDOW=128000
LLM_MAX_TOKENS=8192

# compose 用
HOST_PORT=3300
SUB2API_NETWORK=sub2api-deploy_sub2api-network
