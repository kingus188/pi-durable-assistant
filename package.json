{
  "name": "pi-durable-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "基于 Pi Durable 的网页版个人 Agent：断点恢复、记事本、子 Agent、定时计划、任务中心和微信通道",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -b && node .build/scripts/build.js",
    "check": "tsc -b && node .build/scripts/check-boundaries.js",
    "test": "pnpm run build && node --experimental-vm-modules --test packages/*/dist-tests/*.test.js apps/*/dist-tests/*.test.js tests/dist/*.test.js",
    "start": "pnpm run build && node apps/server/dist/main.js",
    "dev": "pnpm run build && sh scripts/dev.sh",
    "desktop": "pnpm run build && pnpm --filter @assistant/desktop start",
    "desktop:package": "pnpm run build && node .build/scripts/desktop-package.js"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "@electron/packager": "20.3.0",
    "@assistant/contracts": "workspace:*",
    "@assistant/runtime": "workspace:*",
    "@assistant/features": "workspace:*",
    "@assistant/channel-wechat": "workspace:*"
  },
  "packageManager": "pnpm@12.9.1"
}
