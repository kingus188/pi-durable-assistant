{
  "name": "@assistant/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && node --experimental-strip-types ../../scripts/build.ts web",
    "check": "tsc -b tsconfig.json tsconfig.test.json",
    "test": "pnpm run build && tsc -b tsconfig.test.json && node --experimental-vm-modules --test dist-tests/*.test.js"
  },
  "dependencies": {
    "@assistant/contracts": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.2"
  }
}
