{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "tests",
    "outDir": "dist-tests",
    "tsBuildInfoFile": "dist-tests/.tsbuildinfo",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "jsx": "react-jsx"
  },
  "include": [
