{
  "name": "@assistant/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b tsconfig.json tsconfig.test.json",
    "test": "pnpm run check && NODE_ENV=test node --test dist-tests/*.test.js",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@assistant/channel-wechat": "workspace:*",
    "@assistant/contracts": "workspace:*",
    "@assistant/features": "workspace:*",
    "@assistant/runtime": "workspace:*",
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "pg": "8.23.1",
    "ws": "8.22.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2"
  }
}
